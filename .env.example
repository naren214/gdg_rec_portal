# ============================================================
# GDG Recruitment Portal — environment variables
# Copy to .env.local for local dev. NEVER commit real secrets.
# On Vercel these are set in Project → Settings → Environment Variables.
# ============================================================

# --- Firebase (server-side Admin SDK) ---
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxx@your-project-id.iam.gserviceaccount.com"
# Keep the \n escapes; the app converts them to real newlines.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# --- Better Auth ---
# Generate a long random value, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET="a_random_32_character_secret_key"
# MUST be the final Vercel URL in production (no trailing slash).
BETTER_AUTH_URL="http://localhost:3000"

# --- App policy ---
# Comma-separated allowed student email domains.
VIT_EMAIL_DOMAINS="vitstudent.ac.in,vit.ac.in"
# Comma-separated club-admin emails (get the admin panel).
ADMIN_EMAILS="president.gdg@vitstudent.ac.in,recruitment.gdg@vitstudent.ac.in"
# Recruitment window (ISO 8601). The countdown + form gating use these.
RECRUITMENT_START_AT="2026-08-01T00:00:00+05:30"
RECRUITMENT_END_AT="2026-08-31T23:59:59+05:30"

# --- Google OAuth (optional) ---
ENABLE_GOOGLE_AUTH="false"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Nodemailer broadcast (optional, used by admin email composer) ---
EMAIL_USERNAME="your-club-email@gmail.com"
EMAIL_PASSWORD="your-gmail-app-password"

# ============================================================
# Local development with the Firestore emulator (optional):
# FIRESTORE_EMULATOR_HOST="127.0.0.1:8080"
# ============================================================
