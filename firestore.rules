rules_version = '2';

// All database access in this app happens server-side via the Firebase Admin
// SDK (which bypasses security rules). The web client never talks to
// Firestore directly, so we deny ALL client access by default.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
